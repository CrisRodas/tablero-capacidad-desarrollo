# Copia este archivo a .env y completa tus valores
# Token de la API de ClickUp (Settings > Apps > API Token)
CLICKUP_API_TOKEN=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID de tu Workspace/Team en ClickUp (aparece en la URL: app.clickup.com/<TEAM_ID>/...)
CLICKUP_TEAM_ID=1234567

# Capacidad estandar por desarrollador (horas por semana)
CAPACITY_HOURS_PER_WEEK=40
